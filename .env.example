# Supabase — proyecto público (cliente)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Solo servidor. Nunca exponer en el cliente.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Sal para el hash SHA-256 de IPs en assessment_requests (cadena aleatoria larga)
NEXUS_IP_HASH_SALT=change-me-to-a-long-random-string

# Observabilidad: "console" (stdout JSON) o "silent"
NEXUS_LOG_SINK=console
NEXUS_LOG_LEVEL=info
