# Supabase — proyecto público (cliente)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Solo servidor. Nunca exponer en el cliente.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Sal para el hash SHA-256 de IPs en assessment_requests (cadena aleatoria larga)
NEXUS_IP_HASH_SALT=change-me-to-a-long-random-string

# Observabilidad: "console" (stdout JSON) o "silent"
NEXUS_LOG_SINK=console
NEXUS_LOG_LEVEL=info

# Dominio público (enlaces del correo y metadatos)
# Detrás de Hostinger defínela siempre: las redirecciones de /auth/confirm (invitaciones) usan este origen
# y no la dirección interna del proceso (0.0.0.0:3000). En local déjala vacía.
SITE_URL=https://nexusio.com.mx

# Recuperación de contraseña: saltos de proxy de confianza en x-forwarded-for (1 = un solo proxy) y tope global por hora.
TRUSTED_PROXY_HOPS=1
RESET_GLOBAL_LIMIT_PER_HOUR=1000

# Panel /admin: correos autorizados, separados por coma
ADMIN_EMAILS=tu-correo@nexusio.com.mx

# Interruptor de seguridad del borrado de inspecciones/máquinas/proyectos (solo admin).
# Activo por defecto. Para desactivarlo en producción pon INSPECTIONS_DELETE_ENABLED=false
# en Hostinger y redespliega (o reinicia). Valores que lo desactivan: false, 0, off, no.
INSPECTIONS_DELETE_ENABLED=true

# Vida (en días, entero de 1 a 365) de las URLs firmadas estables con las que /api/media lee Storage.
# Por defecto 7. Solo afecta al servidor: el navegador nunca ve esas URLs. Ver README, «Caché de imágenes».
MEDIA_URL_TTL_DAYS=7

# Aviso por correo de cada solicitud (cuenta de correo de Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contacto@nexusio.com.mx
SMTP_PASSWORD=
NOTIFY_EMAIL=contacto@nexusio.com.mx

# Mapa del parque (opcional): llave de ArcGIS Location Platform para el botón Satélite (Esri World Imagery)
# OJO: al ser NEXT_PUBLIC_* la llave es pública (va en el navegador). Créala en ArcGIS con alcance
# solo a basemaps y restringida por referrer al dominio del sitio.
# NEXT_PUBLIC_ESRI_API_KEY=
